# Deploy app oficial (hbcooperativas) — novo modelo BIC + UI unificada
# Copie estas chaves no Vercel → Production. NÃO use flags HB_BIC_LAB_* aqui.
# Não roda wipe, reset operacional nem migrations destrutivas — só leitura/UI.

APP_ENV=production
BIC_ENVIRONMENT=PRODUCTION

# Trava espelho LAB no build oficial
NEXT_PUBLIC_HB_BIC_PRODUCTION_LOCK=true

# Leitura central BIC (mesmo motor validado no LAB B4)
NEXT_PUBLIC_BIC_CENTRAL_READ_OFFICIAL=true
# Ficha / integração leitura unificada (equivalente LAB FULL)
NEXT_PUBLIC_BIC_CENTRAL_READ_FULL_OFFICIAL=true

# HB Créditos visível + sync valor a receber (todos cooperados)
NEXT_PUBLIC_CONTA_COOP_UI_PUBLIC=1
NEXT_PUBLIC_CONTA_COOP_VALOR_RECEBER_PUBLIC=1

# Supabase PRODUÇÃO — manter URL/chaves atuais do projeto (ifptyz…)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Proibido no oficial:
# HB_BIC_LAB_ENABLED, NEXT_PUBLIC_HB_BIC_LAB_ENABLED, HB_BIC_LAB_B4_AUTHORITY, HB_BIC_LAB_FULL
