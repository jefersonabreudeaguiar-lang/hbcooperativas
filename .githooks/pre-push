#!/usr/bin/env sh
# Após o push (hook roda antes do envio; aguardamos e então confirmamos produção no main).
branch="$(git symbolic-ref --short HEAD 2>/dev/null || true)"
remote="${1:-origin}"

if [ "$branch" != "main" ]; then
  exit 0
fi

case "$remote" in
  origin|https://github.com*|git@github.com*) ;;
  *) exit 0 ;;
esac

expect_sha="$(git rev-parse HEAD)"
(
  sleep 25
  cd "$(git rev-parse --show-toplevel)" || exit 0
  npm run confirm:production:wait -- --expect-sha "$expect_sha"
) &

exit 0
