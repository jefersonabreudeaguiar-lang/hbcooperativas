# Hobelisco LAB espelho — copie para .env.local (deploy LAB dedicado)
# NUNCA configure estas flags no projeto Vercel de produção (hbcooperativas.vercel.app)

# --- Fronteira LAB ↔ Produção (obrigatório) ---
HOBELISCO_ENVIRONMENT=LAB
HB_HOBELISCO_LAB_DEPLOY=true
HB_HOBELISCO_MIRROR_ENABLED=true
HB_HOBELISCO_BOUNDARY_STRICT=true

# Ref do projeto Supabase de PRODUÇÃO — só para comparação/tripwire (nunca usar como destino Hobelisco)
HB_HOBELISCO_PRODUCTION_SUPABASE_REF=

# Supabase LAB dedicado (projeto separado — onde aplicou hb_hobelisco_v2_staging.sql)
HB_HOBELISCO_LAB_SUPABASE_URL=
HB_HOBELISCO_LAB_SERVICE_ROLE_KEY=

# Alias staging (opcional se já usa nomes staging)
# HB_HOBELISCO_STAGING_SUPABASE_URL=
# HB_HOBELISCO_STAGING_SERVICE_ROLE_KEY=
HB_HOBELISCO_STAGING_ENABLED=true

# --- LAB sempre ativo neste deploy ---
HB_HOBELISCO_LAB_ENABLED=true
NEXT_PUBLIC_HB_HOBELISCO_LAB_ENABLED=true
NEXT_PUBLIC_HB_HOBELISCO_PRODUCTION_LOCK=false

# --- Observer V2 (Fase 0: observe-only; defesas ativas vêm na Fase 2) ---
HB_HOBELISCO_V2_ENABLED=true
HB_HOBELISCO_OBSERVE_ONLY=true

# Cooperativa piloto (probes read-only)
HB_HOBELISCO_PROBE_COOP_CNPJ=

# --- Defesas (Fase 0: OFF até Fase 2; flags documentadas para deploy LAB) ---
HOBELISCO_ACTIVE_DEFENSE_ENABLED=false
HB_ADAPTIVE_DEFENSE_ENABLED=false
HOBELISCO_AUTO_REPAIR=false
HOBELISCO_FABRIC_MODE=SHADOW
HB_HOBELISCO_CREDIT_WATCH_ENABLED=false
HB_HOBELISCO_WHATSAPP_ENABLED=false

# App HB Coop neste deploy LAB (pode ser Supabase espelho anonimizado — NÃO o de produção financeiro)
# NEXT_PUBLIC_SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# Cron (Fase 1+)
# CRON_SECRET=
# HB_HOBELISCO_MIRROR_GITHUB_REPO=jefersonabreudeaguiar-lang/hbcooperativas
# HB_HOBELISCO_MIRROR_PROD_REF=main
