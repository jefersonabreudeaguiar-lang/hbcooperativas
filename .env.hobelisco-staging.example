# Hobelisco STAGING Observe-Only — copie para .env.local

HOBELISCO_ENVIRONMENT=STAGING
HB_HOBELISCO_V2_ENABLED=true
HB_HOBELISCO_OBSERVE_ONLY=true
HB_HOBELISCO_STAGING_ENABLED=true

# Supabase staging (mesmo projeto onde aplicou hb_hobelisco_v2_staging.sql)
HB_HOBELISCO_STAGING_SUPABASE_URL=
HB_HOBELISCO_STAGING_SERVICE_ROLE_KEY=

# Cooperativa piloto (read-only probes)
HB_HOBELISCO_PROBE_COOP_CNPJ=

# Fase 1 — manter false
HB_HOBELISCO_CREDIT_WATCH_ENABLED=false
HOBELISCO_ACTIVE_DEFENSE_ENABLED=false
HB_HOBELISCO_WHATSAPP_ENABLED=false
